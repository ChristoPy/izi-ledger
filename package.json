{
  "name": "izi-ledger",
  "version": "0.1.0",
  "description": "Double-entry, zero-sum, hash-chained ledger on SQLite. Strong consistency, idempotency and crash safety. Works on Node and Bun.",
  "keywords": [
    "ledger",
    "double-entry",
    "accounting",
    "sqlite",
    "bun",
    "idempotency",
    "hash-chain",
    "balance"
  ],
  "license": "MIT",
  "author": "Christopher Ribeiro <christo_campiglia@hotmail.com> (https://github.com/ChristoPy)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChristoPy/izi-ledger.git"
  },
  "bugs": {
    "url": "https://github.com/ChristoPy/izi-ledger/issues"
  },
  "homepage": "https://github.com/ChristoPy/izi-ledger#readme",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "bun": "./dist/esm/index.js",
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      },
      "default": "./dist/esm/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.esm.json && tsc -p tsconfig.cjs.json && node scripts/fixup-cjs.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check --error-on-warnings",
    "lint:fix": "biome check --write",
    "format": "biome format --write",
    "test": "bun test",
    "test:node": "node --no-warnings --test scripts/test-node-drivers.mjs",
    "test:drivers": "node scripts/test-all-drivers.mjs",
    "example": "bun run examples/payments.ts",
    "check": "bun run lint && bun run typecheck && bun test",
    "prepublishOnly": "bun run lint && bun run typecheck && bun test && bun run build"
  },
  "peerDependencies": {
    "better-sqlite3": ">=9"
  },
  "peerDependenciesMeta": {
    "better-sqlite3": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@types/better-sqlite3": "^9.6.0",
    "@types/bun": "^1.1.14",
    "@types/node": "^26.2.0",
    "better-sqlite3": "^13.0.3",
    "typescript": "^7.0.2"
  },
  "trustedDependencies": [
    "better-sqlite3",
    "@biomejs/biome"
  ]
}

{
  "name": "izi-ledger",
  "version": "0.1.0",
  "description": "Double-entry, zero-sum, hash-chained ledger on SQLite. Strong consistency, idempotency and crash safety. Works on Node and Bun.",
  "keywords": ["ledger", "double-entry", "accounting", "sqlite", "bun", "idempotency", "hash-chain", "balance"],
  "license": "MIT",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "bun": "./dist/esm/index.js",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "default": "./dist/esm/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "engines": { "node": ">=20" },
  "sideEffects": false,
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.esm.json && tsc -p tsconfig.cjs.json && node scripts/fixup-cjs.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test",
    "test:drivers": "node scripts/test-all-drivers.mjs",
    "test:node": "node --no-warnings --test scripts/test-node-drivers.mjs",
    "prepublishOnly": "bun run typecheck && bun test && bun run build"
  },
  "peerDependencies": {
    "better-sqlite3": ">=9"
  },
  "peerDependenciesMeta": {
    "better-sqlite3": { "optional": true }
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/bun": "^1.1.14",
    "@types/node": "^22.10.0",
    "better-sqlite3": "^11.7.0",
    "typescript": "^5.7.2"
  }
}
